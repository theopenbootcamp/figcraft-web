new file mode 100644
index 0000000..bb81802
--- /dev/null
+++ b/apps/figcraft-web/src/bridge.rs
@@ -0,0 +1,188 @@
+//! The tutorial bridge: lets a page that embeds the web build in an `<iframe>` drive and read the
+//! editor through `postMessage`, using the same control channel the desktop app serves on its
+//! loopback socket (`figcraft_ui_egui::control`, `docs/control-protocol.md`).
+//!
+//! The embedding page posts
+//!
+//! ```json
+//! {"type": "figcraft", "id": 1, "method": "engine.execute", "params": {"command": "shape.rectangle", "params": {}}}
+//! ```
+//!
+//! and gets back, posted to its own origin only,
+//!
+//! ```json
+//! {"type": "figcraft", "id": 1, "ok": true, "result": {"id": 12}}
+//! {"type": "figcraft", "id": 1, "ok": false, "error": "message"}
+//! ```
+//!
+//! `bridge.hello` answers at once with the bridge version and its methods; a page posts it until it
+//! gets an answer, which tells it the app has started.
+//!
+//! Safety:
+//! - Only pages on [`crate::policy::ORIGINS`] (and `http://localhost` / `http://127.0.0.1` on any port, and any
+//!   origin listed in the `FIGCRAFT_BRIDGE_ORIGINS` build variable, comma-separated) are answered;
+//!   messages from anywhere else are ignored without a reply.
+//! - Only the methods in [`crate::policy::METHODS`] run: no input injection, no windows, no screenshots to paths.
+//! - `engine.execute` refuses commands that could reach outside the page or the visitor's machine
+//!   (sharing and live sessions, plugins, saving and exporting files, opening links), also inside a
+//!   `command.batch`.
+//! - At most `MAX_PENDING` requests wait at once, each message at most `MAX_BYTES`.
+
+use std::cell::RefCell;
+use std::collections::HashMap;
+use std::rc::Rc;
+use std::sync::Arc;
+use std::sync::atomic::AtomicBool;
+use std::sync::mpsc;
+
+use figcraft_ui_egui::{ControlReply, ControlRequest, FigApp};
+use serde_json::{Value, json};
+use wasm_bindgen::JsCast as _;
+use wasm_bindgen::closure::Closure;
+
+use crate::policy::{MAX_BYTES, MAX_PENDING, METHODS, VERSION, allowed, check};
+
+/// A request parsed from a message, with who to answer.
+struct Incoming {
+    id: Value,
+    method: String,
+    params: Value,
+    to: Peer,
+}
+
+/// The page that asked: its window and origin (replies go to that origin only).
+#[derive(Clone)]
+struct Peer {
+    window: web_sys::Window,
+    origin: String,
+}
+
+pub struct Bridge {
+    inbox: Rc<RefCell<Vec<Incoming>>>,
+    waiting: HashMap<u64, (Value, Peer)>,
+    tx: mpsc::Sender<ControlReply>,
+    rx: mpsc::Receiver<ControlReply>,
+    next: u64,
+    _listener: Option<Closure<dyn FnMut(web_sys::MessageEvent)>>,
+    _focus: Option<Closure<dyn FnMut(web_sys::Event)>>,
+}
+
+/// When the embedding page hands this window the focus (a tutorial does after its own buttons are
+/// clicked), pass it on to the canvas, where egui listens for keys. Without this the keys land on
+/// `<body>` and shortcuts do nothing until the learner clicks the editor.
+fn focus_canvas_if_idle() {
+    let Some(doc) = web_sys::window().and_then(|w| w.document()) else { return };
+    let body = doc.body();
+    let idle = doc.active_element().is_none_or(|el| body.as_ref().is_some_and(|b| b.is_same_node(Some(&el))));
+    if !idle {
+        return;
+    }
+    if let Some(canvas) = doc.get_element_by_id("figcraft_canvas").and_then(|el| el.dyn_into::<web_sys::HtmlElement>().ok()) {
+        let _ = canvas.focus();
+    }
+}
+
+impl Bridge {
+    /// Listens for `message` events on the window; each accepted one wakes the app for a frame.
+    pub fn install(ctx: egui::Context) -> Self {
+        let inbox: Rc<RefCell<Vec<Incoming>>> = Rc::new(RefCell::new(Vec::new()));
+        let (tx, rx) = mpsc::channel();
+        let sink = inbox.clone();
+        let listener = Closure::<dyn FnMut(web_sys::MessageEvent)>::new(move |e: web_sys::MessageEvent| {
+            let origin = e.origin();
+            if !allowed(&origin) {
+                return;
+            }
+            let Some(msg) = parse(&e.data()) else { return };
+            if msg.get("type").and_then(Value::as_str) != Some("figcraft") || msg.get("ok").is_some() {
+                return;
+            }
+            // The page that posted (a cross-origin parent arrives as a WindowProxy, so no
+            // `instanceof Window` check), else our parent.
+            let window = e
+                .source()
+                .map(wasm_bindgen::JsCast::unchecked_into::<web_sys::Window>)
+                .or_else(|| web_sys::window().and_then(|w| w.parent().ok().flatten()));
+            let Some(window) = window else { return };
+            let to = Peer { window, origin };
+            let id = msg.get("id").cloned().unwrap_or(Value::Null);
+            let method = msg.get("method").and_then(Value::as_str).unwrap_or("").to_string();
+            let params = msg.get("params").cloned().unwrap_or_else(|| json!({}));
+            let mut q = sink.borrow_mut();
+            if q.len() >= MAX_PENDING {
+                post(&to, &json!({"type": "figcraft", "id": id, "ok": false, "error": "too many requests waiting"}));
+                return;
+            }
+            q.push(Incoming { id, method, params, to });
+            drop(q);
+            ctx.request_repaint();
+        });
+        let installed = web_sys::window().is_some_and(|w| w.add_event_listener_with_callback("message", listener.as_ref().unchecked_ref()).is_ok());
+        if !installed {
+            log::warn!("figcraft-web: the tutorial bridge couldn't listen for messages");
+        }
+        let focus = Closure::<dyn FnMut(web_sys::Event)>::new(|_: web_sys::Event| focus_canvas_if_idle());
+        let focusing = web_sys::window().is_some_and(|w| w.add_event_listener_with_callback("focus", focus.as_ref().unchecked_ref()).is_ok());
+        Self { inbox, waiting: HashMap::new(), tx, rx, next: 1, _listener: installed.then_some(listener), _focus: focusing.then_some(focus) }
+    }
+
+    /// Before the frame: hand accepted requests to the app's control queue (it runs them at the
+    /// start of the frame) and answer the ones that never reach it.
+    pub fn pump(&mut self, app: &mut FigApp) {
+        let incoming = std::mem::take(&mut *self.inbox.borrow_mut());
+        for m in incoming {
+            if m.method == "bridge.hello" {
+                post(&m.to, &json!({"type": "figcraft", "id": m.id, "ok": true, "result": {"version": VERSION, "methods": METHODS}}));
+                continue;
+            }
+            if let Err(e) = check(&m.method, &m.params) {
+                post(&m.to, &json!({"type": "figcraft", "id": m.id, "ok": false, "error": e}));
+                continue;
+            }
+            let key = self.next;
+            self.next = self.next.wrapping_add(1);
+            self.waiting.insert(key, (m.id, m.to));
+            app.control_queue.push(ControlRequest {
+                id: json!(key),
+                method: m.method,
+                params: m.params,
+                reply: self.tx.clone(),
+                cancelled: Arc::new(AtomicBool::new(false)),
+            });
+        }
+    }
+
+    /// After the frame: post the replies back to the pages that asked.
+    pub fn flush(&mut self) {
+        while let Ok(r) = self.rx.try_recv() {
+            let Some(key) = r.id.as_u64() else { continue };
+            let Some((id, to)) = self.waiting.remove(&key) else { continue };
+            let msg = match r.result {
+                Ok(v) => json!({"type": "figcraft", "id": id, "ok": true, "result": v}),
+                Err(e) => json!({"type": "figcraft", "id": id, "ok": false, "error": e}),
+            };
+            post(&to, &msg);
+        }
+    }
+}
+
+/// A message's data as JSON: a JSON string, or a structured-clone object (read back through
+/// `JSON.stringify`). Oversized or unreadable data is ignored.
+fn parse(data: &wasm_bindgen::JsValue) -> Option<Value> {
+    let text = match data.as_string() {
+        Some(s) => s,
+        None => js_sys::JSON::stringify(data).ok()?.as_string()?,
+    };
+    if text.len() > MAX_BYTES {
+        return None;
+    }
+    serde_json::from_str(&text).ok()
+}
+
+fn post(to: &Peer, msg: &Value) {
+    let Ok(text) = serde_json::to_string(msg) else { return };
+    let Ok(value) = js_sys::JSON::parse(&text) else { return };
+    if let Err(e) = to.window.post_message(&value, &to.origin) {
+        log::warn!("figcraft-web: couldn't reply to {}: {e:?}", to.origin);
+    }
+}
