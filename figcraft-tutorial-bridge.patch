diff --git a/crates/ui-egui/src/landmarks.rs b/crates/ui-egui/src/landmarks.rs
new file mode 100644
index 0000000..ef50234
--- /dev/null
+++ b/crates/ui-egui/src/landmarks.rs
@@ -0,0 +1,60 @@
+//! Named screen rectangles for parts of the interface, so a page that embeds the web build (a
+//! tutorial, see `apps/figcraft-web/src/bridge.rs`) can point at a control: "the Auto layout
+//! section", "the frame tool", "the Card row in the layers panel". Panels record them while they
+//! draw; `ui.landmarks` reports the ones drawn in the last frame, in logical points (CSS pixels in
+//! the browser).
+
+use std::collections::BTreeMap;
+
+use egui::{Context, Id, Rect};
+
+/// Most landmarks kept: the layer rows of a long file shouldn't grow the map without end.
+const MAX: usize = 400;
+
+#[derive(Clone, Default)]
+struct Marks(BTreeMap<String, (Rect, u64)>);
+
+fn key() -> Id {
+    Id::new("figcraft_landmarks")
+}
+
+/// Record `rect` as the landmark `name` for this frame (empty, inverted or non-finite rects are
+/// ignored, so a control scrolled out of view or not drawn simply isn't reported).
+pub fn mark(ctx: &Context, name: &str, rect: Rect) {
+    if !rect.is_finite() || !rect.is_positive() {
+        return;
+    }
+    let pass = ctx.cumulative_pass_nr();
+    ctx.data_mut(|d| {
+        let m = d.get_temp_mut_or_default::<Marks>(key());
+        if m.0.len() >= MAX && !m.0.contains_key(name) {
+            // Drop the stalest one to make room.
+            if let Some(old) = m.0.iter().min_by_key(|(_, (_, p))| *p).map(|(k, _)| k.clone()) {
+                m.0.remove(&old);
+            }
+        }
+        m.0.insert(name.to_string(), (rect, pass));
+    });
+}
+
+/// Like [`mark`], clipped to what the `ui` shows (rows in a scroll area).
+pub fn mark_visible(ui: &egui::Ui, name: &str, rect: Rect) {
+    mark(ui.ctx(), name, rect.intersect(ui.clip_rect()));
+}
+
+/// Record the band of `ui` drawn since `y0` (a whole panel section, full width) as `name`, clipped
+/// to what the panel shows. Call it right after drawing the section.
+pub fn band_since(ui: &egui::Ui, name: &str, y0: f32) {
+    let x = ui.max_rect().x_range();
+    mark_visible(ui, name, Rect::from_x_y_ranges(x, y0..=ui.cursor().top().max(y0)));
+}
+
+/// The landmarks drawn in the last frame (or this one): `{name: [x0, y0, x1, y1]}`.
+pub fn list(ctx: &Context) -> BTreeMap<String, [f32; 4]> {
+    let pass = ctx.cumulative_pass_nr();
+    ctx.data(|d| d.get_temp::<Marks>(key()))
+        .map(|m| {
+            m.0.into_iter().filter(|(_, (_, p))| pass.saturating_sub(*p) <= 1).map(|(k, (r, _))| (k, [r.min.x, r.min.y, r.max.x, r.max.y])).collect()
+        })
+        .unwrap_or_default()
+}
