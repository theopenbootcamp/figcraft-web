diff --git a/apps/figcraft-web/src/policy.rs b/apps/figcraft-web/src/policy.rs
new file mode 100644
index 0000000..b03e1f4
--- /dev/null
+++ b/apps/figcraft-web/src/policy.rs
@@ -0,0 +1,149 @@
+//! What the tutorial bridge (`bridge.rs`) lets an embedding page do: which origins it answers,
+//! which control methods they may call, and which commands `engine.execute` refuses. Plain logic,
+//! built on every target so its tests run natively.
+
+use serde_json::Value;
+
+/// Bumped when the message format or the method list changes.
+pub const VERSION: u32 = 1;
+
+/// Pages allowed to use the bridge (exact origins).
+pub const ORIGINS: &[&str] = &["https://uxuiopen.com", "https://www.uxuiopen.com"];
+
+/// Methods an embedding page may call.
+pub const METHODS: &[&str] =
+    &["bridge.hello", "engine.execute", "engine.commands", "document.inspect", "node.get", "ui.inspect", "ui.set", "ui.landmarks"];
+
+/// Command ids (or id prefixes ending in `.`) `engine.execute` refuses.
+pub const BLOCKED: &[&str] = &[
+    "collab.",
+    "plugin.",
+    "plugins.",
+    "app.",
+    "help.",
+    "file.save",
+    "file.saveAs",
+    "file.export",
+    "file.exportSvg",
+    "export.",
+    "devResource.open",
+    "link.open",
+];
+
+pub const MAX_PENDING: usize = 32;
+pub const MAX_BYTES: usize = 4 * 1024 * 1024;
+
+/// Whether `origin` may use the bridge.
+pub fn allowed(origin: &str) -> bool {
+    if ORIGINS.contains(&origin) {
+        return true;
+    }
+    if let Some(extra) = option_env!("FIGCRAFT_BRIDGE_ORIGINS")
+        && extra.split(',').map(str::trim).any(|o| !o.is_empty() && o == origin)
+    {
+        return true;
+    }
+    local(origin)
+}
+
+/// `http://localhost` or `http://127.0.0.1`, with or without a port (a developer's own machine).
+fn local(origin: &str) -> bool {
+    ["http://localhost", "http://127.0.0.1"].iter().any(|h| {
+        origin == *h
+            || origin
+                .strip_prefix(h)
+                .and_then(|r| r.strip_prefix(':'))
+                .is_some_and(|port| !port.is_empty() && port.chars().all(|c| c.is_ascii_digit()))
+    })
+}
+
+/// Why `command` (with `params`) is refused, if it is; looks inside `command.batch` steps too.
+pub fn refused(command: &str, params: &Value, depth: usize) -> Option<String> {
+    if depth > 8 {
+        return Some("command.batch is nested too deeply".into());
+    }
+    let hit = BLOCKED.iter().any(|b| if b.ends_with('.') { command.starts_with(b) } else { command == *b });
+    if hit {
+        return Some(format!("`{command}` isn't available to embedding pages"));
+    }
+    if command == "command.batch"
+        && let Some(steps) = params.get("commands").and_then(Value::as_array)
+    {
+        for s in steps {
+            let c = s.get("command").and_then(Value::as_str).unwrap_or("");
+            let p = s.get("params").cloned().unwrap_or(Value::Null);
+            if let Some(why) = refused(c, &p, depth + 1) {
+                return Some(why);
+            }
+        }
+    }
+    None
+}
+
+/// Whether a method (with its params) may run; the error to reply with if not.
+pub fn check(method: &str, params: &Value) -> Result<(), String> {
+    if !METHODS.contains(&method) {
+        return Err(format!("method `{method}` isn't available to embedding pages"));
+    }
+    if method == "engine.execute" {
+        let c = params.get("command").and_then(Value::as_str).ok_or("`command` required")?;
+        let p = params.get("params").cloned().unwrap_or(Value::Null);
+        if let Some(why) = refused(c, &p, 0) {
+            return Err(why);
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use serde_json::json;
+
+    #[test]
+    fn origins() {
+        assert!(allowed("https://uxuiopen.com"));
+        assert!(allowed("https://www.uxuiopen.com"));
+        assert!(allowed("http://localhost:3000"));
+        assert!(allowed("http://127.0.0.1"));
+        assert!(!allowed("https://uxuiopen.com.evil.example"));
+        assert!(!allowed("http://localhost.evil.example"));
+        assert!(!allowed("http://localhost:3000x"));
+        assert!(!allowed("http://localhost:"));
+        assert!(!allowed("https://example.com"));
+        assert!(!allowed("null"));
+        assert!(!allowed(""));
+    }
+
+    #[test]
+    fn methods_and_commands() {
+        assert!(check("document.inspect", &json!({})).is_ok());
+        assert!(check("ui.landmarks", &json!({"nodes": [1]})).is_ok());
+        assert!(check("engine.execute", &json!({"command": "shape.rectangle", "params": {}})).is_ok());
+        assert!(check("ui.pointer", &json!({})).is_err());
+        assert!(check("window.new", &json!({})).is_err());
+        assert!(check("app.quit", &json!({})).is_err());
+        assert!(check("engine.execute", &json!({})).is_err());
+        assert!(check("engine.execute", &json!({"command": "collab.share"})).is_err());
+        assert!(check("engine.execute", &json!({"command": "plugin.run"})).is_err());
+        assert!(check("engine.execute", &json!({"command": "file.save"})).is_err());
+        assert!(check("engine.execute", &json!({"command": "file.saveAs"})).is_err());
+        // An exact block doesn't catch a longer id that only starts the same.
+        assert!(check("engine.execute", &json!({"command": "file.new"})).is_ok());
+    }
+
+    #[test]
+    fn batches_are_checked_step_by_step() {
+        let ok = json!({"command": "command.batch", "params": {"commands": [{"command": "node.create", "params": {"type": "frame"}}]}});
+        assert!(check("engine.execute", &ok).is_ok());
+        let bad = json!({"command": "command.batch", "params": {"commands": [{"command": "node.create"}, {"command": "collab.share"}]}});
+        assert!(check("engine.execute", &bad).is_err());
+        let nested = json!({"command": "command.batch", "params": {"commands": [{"command": "command.batch", "params": {"commands": [{"command": "app.quit"}]}}]}});
+        assert!(check("engine.execute", &nested).is_err());
+        let mut deep = json!({"command": "node.create"});
+        for _ in 0..12 {
+            deep = json!({"command": "command.batch", "params": {"commands": [deep]}});
+        }
+        assert!(check("engine.execute", &json!({"command": "command.batch", "params": deep["params"]})).is_err());
+    }
+}
