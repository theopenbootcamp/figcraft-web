@@ -0,0 +1,98 @@
+//! `ui.landmarks`: named interface rectangles and layer boxes on screen, for pages that embed the
+//! web build (the tutorial bridge). The rectangles must be where the controls really are: a click
+//! in the middle of `design.layout.add` adds auto layout.
+use egui::pos2;
+use serde_json::{Value, json};
+
+use crate::control::handle;
+use crate::live_tests::Harness;
+
+fn landmarks(h: &mut Harness, nodes: &[u64]) -> Value {
+    h.frames(3);
+    handle(&mut h.app, &h.ctx, "ui.landmarks", &json!({"nodes": nodes})).unwrap()
+}
+
+fn center(r: &Value) -> egui::Pos2 {
+    let v: Vec<f32> = r.as_array().unwrap().iter().map(|x| x.as_f64().unwrap() as f32).collect();
+    pos2((v[0] + v[2]) / 2.0, (v[1] + v[3]) / 2.0)
+}
+
+#[test]
+fn landmarks_point_at_real_controls() {
+    let (mut h, _) = Harness::new();
+    let s = &mut h.app.session;
+    let card = s.execute("node.create", &json!({"type": "frame", "name": "Card", "x": 400, "y": 200, "width": 200, "height": 300})).unwrap()["id"]
+        .as_u64()
+        .unwrap();
+    s.execute("node.create", &json!({"type": "rectangle", "parent": card, "x": 20, "y": 20, "width": 100, "height": 40})).unwrap();
+    s.execute("node.create", &json!({"type": "rectangle", "parent": card, "x": 20, "y": 100, "width": 100, "height": 40})).unwrap();
+    s.execute("select.set", &json!({"ids": [card]})).unwrap();
+
+    let l = landmarks(&mut h, &[card]);
+    for name in [
+        "toolbar",
+        "toolbar.frame",
+        "toolbar.mode.design",
+        "panel.left",
+        "panel.right",
+        "design.layout.header",
+        "design.layout.add",
+        "design.layout.dimensions",
+    ] {
+        assert!(l["landmarks"].get(name).is_some(), "{name} is reported: {}", l["landmarks"]);
+    }
+    assert!(l["landmarks"].get(format!("layer.{card}")).is_some(), "the card's layer row is reported");
+    assert!(l["landmarks"].get("design.layout.spacing").is_none(), "no spacing fields before auto layout");
+    // The card's box is on the canvas, as big as the card at this zoom.
+    let b: Vec<f64> = l["nodes"][card.to_string()].as_array().unwrap().iter().map(|x| x.as_f64().unwrap()).collect();
+    let c: Vec<f64> = l["canvas"].as_array().unwrap().iter().map(|x| x.as_f64().unwrap()).collect();
+    let z = l["zoom"].as_f64().unwrap();
+    assert!((b[2] - b[0] - 200.0 * z).abs() < 1.0 && (b[3] - b[1] - 300.0 * z).abs() < 1.0, "{b:?} at zoom {z}");
+    assert!(b[0] >= c[0] - 1000.0 && b[1] >= c[1] - 1000.0, "{b:?} relative to the canvas {c:?}");
+
+    // Clicking the reported + adds auto layout.
+    let add = center(&l["landmarks"]["design.layout.add"]);
+    h.click(add);
+    h.frames(2);
+    let doc = h.app.session.doc().unwrap();
+    assert!(doc.node(figcraft_doc::NodeId(card)).unwrap().layout.is_some(), "the click at {add:?} landed on Add auto layout");
+
+    let l = landmarks(&mut h, &[]);
+    for name in ["design.layout.remove", "design.layout.direction", "design.layout.alignment", "design.layout.spacing"] {
+        assert!(l["landmarks"].get(name).is_some(), "{name} is reported once there is auto layout");
+    }
+    assert!(l["landmarks"].get("design.layout.add").is_none(), "the + became a −");
+}
+
+#[test]
+fn landmarks_not_drawn_are_dropped() {
+    let (mut h, _) = Harness::new();
+    let s = &mut h.app.session;
+    let f = s.execute("node.create", &json!({"type": "frame", "width": 100, "height": 100})).unwrap()["id"].as_u64().unwrap();
+    s.execute("select.set", &json!({"ids": [f]})).unwrap();
+    assert!(landmarks(&mut h, &[])["landmarks"].get("design.layout.header").is_some());
+    h.app.session.execute("select.none", &json!({})).unwrap();
+    assert!(landmarks(&mut h, &[])["landmarks"].get("design.layout.header").is_none(), "nothing selected: no layout section");
+    // Unknown and junk ids are skipped.
+    let l = handle(&mut h.app, &h.ctx, "ui.landmarks", &json!({"nodes": [999_999, "x", -1]})).unwrap();
+    assert_eq!(l["nodes"], json!({}));
+}
+
+#[test]
+fn design_panel_sections_are_marked_in_order() {
+    let (mut h, _) = Harness::new();
+    let s = &mut h.app.session;
+    let t = s.execute("node.create", &json!({"type": "text", "name": "T", "x": 40, "y": 40, "text": "Hello"})).unwrap()["id"].as_u64().unwrap();
+    s.execute("select.set", &json!({"ids": [t]})).unwrap();
+    let l = landmarks(&mut h, &[]);
+    let top = |name: &str| -> f64 {
+        let r = l["landmarks"].get(name).unwrap_or_else(|| panic!("{name} missing: {l}"));
+        let v = r.as_array().unwrap();
+        assert!(v[3].as_f64().unwrap() > v[1].as_f64().unwrap(), "{name} is empty");
+        v[1].as_f64().unwrap()
+    };
+    let order = ["design.position", "design.appearance", "design.typography", "design.fill"].map(top);
+    assert!(order.windows(2).all(|w| w[0] < w[1]), "sections out of order: {order:?}");
+    let right = l["landmarks"]["panel.right"].as_array().unwrap()[0].as_f64().unwrap();
+    assert!(l["landmarks"]["design.fill"].as_array().unwrap()[0].as_f64().unwrap() >= right - 1.0);
+}
