     drag(&mut s, (225.0, 425.0), (525.0, 125.0));
     assert_eq!(parent(&s, a), Some(frame), "outside a group, a frame takes the drop");
 }
+
+#[test]
+fn layers_dropped_into_a_frame_keep_their_stacking_order_whatever_the_selection_order() {
+    for flow in [false, true] {
+        let mut s = Session::new();
+        let target = ex(&mut s, "frame.create", json!({"x": 0, "y": 0, "width": 300, "height": 300}));
+        if flow {
+            s.execute("layout.add", &json!({"ids": [target]})).unwrap();
+        }
+        // Bottom to top: a, b, c, side by side to the right of the frame.
+        let kids: Vec<NodeId> =
+            (0..3).map(|i| ex(&mut s, "shape.rectangle", json!({"x": 400 + i * 40, "y": 20, "width": 30, "height": 30}))).collect();
+        // Selected top first (as Shift-clicking the layer rows from the top does).
+        s.execute("select.set", &json!({"ids": [kids[2], kids[1], kids[0]]})).unwrap();
+        s.execute("tool.set", &json!({"tool": "move"})).unwrap();
+        drag(&mut s, (415.0, 35.0), (100.0, 100.0));
+        let doc = s.doc().unwrap();
+        let inside: Vec<NodeId> = doc.node(target).unwrap().children.clone();
+        assert_eq!(inside, kids, "auto layout: {flow}: dropped in the frame, bottom to top as they were stacked");
+    }
